  "relevant_stored_facts": [
    {
      "id": "custom-types-and-wrappers/component-needs-registration",
      "doc_id": "custom-types-and-wrappers",
      "claim": "A component class alone does not make its type name available; the application must register it under types.",
      "conditions_json": "[]",
      "limits_json": "[]",
      "context": "Why a custom component cannot be selected by type until registered.",
      "source_quote": "Core `FieldType` exposes the field, model, form, options, props, and formControl. `FieldTypeConfig` narrows the control to `FormControl`; group types have a different control shape. Match the base class/generic and template bindings to the actual control. A component class alone does not make its string name available: inspect the application's `types` registration. [K30](sources.md#k30), [K03](sources.md#k03)",
      "source_start_offset": 716,
      "source_end_offset": 1129,
      "status": "authored"
    },
    {
      "id": "custom-types-and-wrappers/fieldtype-surface",
      "doc_id": "custom-types-and-wrappers",
      "claim": "Core FieldType exposes the field, model, form, options, props, and formControl.",
      "conditions_json": "[]",
      "limits_json": "[]",
      "context": "What a custom type component can read.",
      "source_quote": "Core `FieldType` exposes the field, model, form, options, props, and formControl. `FieldTypeConfig` narrows the control to `FormControl`; group types have a different control shape. Match the base class/generic and template bindings to the actual control. A component class alone does not make its string name available: inspect the application's `types` registration. [K30](sources.md#k30), [K03](sources.md#k03)",
      "source_start_offset": 716,
      "source_end_offset": 1129,
      "status": "authored"
    },
    {
      "id": "custom-types-and-wrappers/password-inheritance-example",
      "doc_id": "custom-types-and-wrappers",
      "claim": "The official password example extends input and sets defaults instead of reimplementing its renderer.",
      "conditions_json": "[]",
      "limits_json": "[\"This is an example pattern, not a guarantee about every custom type.\"]",
      "context": "Reusing a registered renderer with altered defaults.",
      "source_quote": "The official password example extends `input` and sets defaults rather than reimplementing the input renderer. This is a useful pattern when behavior is already supplied by the parent type. [E09](examples.md#e09)",
      "source_start_offset": 1514,
      "source_end_offset": 1726,
      "status": "authored"
    },
    {
      "id": "custom-types-and-wrappers/reverse-merged-defaults",
      "doc_id": "custom-types-and-wrappers",
      "claim": "The configuration service fills missing field values through reverse deep merging of type defaults.",
      "conditions_json": "[]",
      "limits_json": "[\"A partial props object need not replace every inherited default; complex precedence should be checked against getMergedField.\"]",
      "context": "How local props combine with registered or inherited defaults.",
      "source_quote": "Type configuration supports `component`, `extends`, `defaultOptions`, and wrappers. The configuration service fills missing values through reverse deep merging; do not assume a field's partial `props` replaces all inherited defaults. Verify complicated inheritance against `getMergedField`, especially wrapper overrides and defaults supplied by the component. [K04](sources.md#k04)",
      "source_start_offset": 1131,
      "source_end_offset": 1512,
      "status": "authored"
    },
    {
      "id": "custom-types-and-wrappers/type-registration-options",
      "doc_id": "custom-types-and-wrappers",
      "claim": "Type registration supports component, extends, defaultOptions, and wrappers.",
      "conditions_json": "[]",
      "limits_json": "[]",
      "context": "Configuring a named custom Formly type.",
      "source_quote": "Type configuration supports `component`, `extends`, `defaultOptions`, and wrappers. The configuration service fills missing values through reverse deep merging; do not assume a field's partial `props` replaces all inherited defaults. Verify complicated inheritance against `getMergedField`, especially wrapper overrides and defaults supplied by the component. [K04](sources.md#k04)",
      "source_start_offset": 1131,
      "source_end_offset": 1512,
      "status": "authored"
    },
    {
      "id": "custom-types-and-wrappers/wrapper-decorates-not-control",
      "doc_id": "custom-types-and-wrappers",
      "claim": "A wrapper decorates a field; it does not replace a missing control or value accessor.",
      "conditions_json": "[]",
      "limits_json": "[]",
      "context": "Choosing a wrapper versus a field type.",
      "source_quote": "`FieldWrapper` extends `FieldType` and supplies the `fieldComponent` insertion target. A custom wrapper needs the expected template insertion point. A wrapper decorates the field; it does not substitute for a missing control/value accessor. [K31](sources.md#k31)",
      "source_start_offset": 2309,
      "source_end_offset": 2571,
      "status": "authored"
    },
