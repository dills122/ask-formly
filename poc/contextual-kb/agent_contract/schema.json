{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Formly library questions v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "formly_questions",
    "library_constraints"
  ],
  "properties": {
    "formly_questions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question",
          "reason"
        ],
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          },
          "reason": {
            "type": "string",
            "minLength": 1,
            "pattern": "\\S"
          }
        }
      }
    },
    "library_constraints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "formly_version",
        "ui_adapter"
      ],
      "properties": {
        "formly_version": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        },
        "ui_adapter": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    }
  }
}
